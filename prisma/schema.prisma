generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  passwordHash  String
  role          String    @default("STUDENT") // ADMIN, HOD, FACULTY, COORDINATOR, STUDENT, PARENT
  isVerified    Boolean   @default(true)        // false for privileged roles until Admin approves
  department    String?
  createdAt     DateTime  @default(now())

  // Relations
  studentProfile    Student?
  facultyProfile    Faculty?
  appealMessages    AppealMessage[]
}

model Student {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollmentNumber String  @unique
  department       String
  currentSemester  Int

  attendances      Attendance[]
  marks            Mark[]
  appeals          Appeal[]
  parents          ParentStudent[]
}

model Faculty {
  id               String  @id @default(cuid())
  userId           String  @unique
  user             User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  department       String

  coursesTaught    Course[]
  marksGiven       Mark[]
  attendancesTaken Attendance[]
}

model Parent {
  id            String  @id @default(cuid())
  userId        String? @unique
  phoneNumber   String?

  students      ParentStudent[]
  meetingReqs   MeetingRequest[]
}

// Join table for many-to-many parents and students
model ParentStudent {
  parentId  String
  studentId String
  parent    Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
}

model Course {
  id            String  @id @default(cuid())
  courseCode    String  @unique
  courseName    String
  credits       Int
  department    String
  semester      Int     @default(1)
  facultyId     String?
  faculty       Faculty?  @relation(fields: [facultyId], references: [id])
  createdAt     DateTime  @default(now())

  attendances   Attendance[]
  marks         Mark[]
  timetables    Timetable[]
}

model Timetable {
  id         String   @id @default(cuid())
  courseId   String
  dayOfWeek  String   // MON, TUE, WED, THU, FRI, SAT
  startTime  String   // "09:00"
  endTime    String   // "10:00"
  room       String?
  department String
  semester   Int

  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

model ExamSchedule {
  id          String   @id @default(cuid())
  courseCode  String
  courseName  String
  examDate    DateTime
  startTime   String
  room        String?
  department  String
  semester    Int
  type        String   @default("MIDTERM") // MIDTERM, FINAL, QUIZ
  createdAt   DateTime @default(now())
}

model Notice {
  id          String   @id @default(cuid())
  title       String
  content     String
  category    String   @default("GENERAL") // GENERAL, EXAM, HOLIDAY, URGENT
  authorId    String
  department  String?  // null = global, set = department-specific
  createdAt   DateTime @default(now())
}

model Attendance {
  id          String   @id @default(cuid())
  studentId   String
  courseId    String
  facultyId   String
  date        DateTime @default(now())
  status      String   // PRESENT, ABSENT, LATE

  student     Student  @relation(fields: [studentId], references: [id])
  course      Course   @relation(fields: [courseId], references: [id])
  faculty     Faculty  @relation(fields: [facultyId], references: [id])
}

model Mark {
  id            String   @id @default(cuid())
  studentId     String
  courseId      String
  facultyId     String
  marksObtained Float
  totalMarks    Float
  topic         String?
  status        String   @default("DRAFT") // DRAFT, PUBLISHED, FINAL

  student       Student  @relation(fields: [studentId], references: [id])
  course        Course   @relation(fields: [courseId], references: [id])
  faculty       Faculty  @relation(fields: [facultyId], references: [id])
  appeals       Appeal[]
}

enum AppealStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  REJECTED
  ESCALATED
}

model Appeal {
  id               String       @id @default(cuid())
  markId           String
  studentId        String
  reason           String
  status           AppealStatus @default(OPEN)

  // Hierarchical Workflow: INSTRUCTOR -> COORDINATOR -> HOD -> ADMIN
  currentStep      Int      @default(1)
  currentAuthority String   @default("INSTRUCTOR")

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  mark        Mark     @relation(fields: [markId], references: [id])
  student     Student  @relation(fields: [studentId], references: [id])
  messages    AppealMessage[]
}

model AppealMessage {
  id        String   @id @default(cuid())
  appealId  String
  authorId  String
  authorRole String   // The role snapshot at time of writing
  text      String
  createdAt DateTime @default(now())

  appeal    Appeal   @relation(fields: [appealId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id])
}

model MeetingRequest {
  id            String   @id @default(cuid())
  parentId      String
  facultyId     String
  status        String   @default("REQUESTED") // REQUESTED, APPROVED, COMPLETED
  createdAt     DateTime @default(now())

  parent        Parent   @relation(fields: [parentId], references: [id])
}
